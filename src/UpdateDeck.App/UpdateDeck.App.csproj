<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <AssemblyName>UpdateDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/UpdateDeck.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <MicrosoftManagementDeployment-FactoryLinkage>none</MicrosoftManagementDeployment-FactoryLinkage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UpdateDeck.Windows/UpdateDeck.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
    <PackageReference Include="Microsoft.WindowsPackageManager.InProcCom" Version="1.29.380" GeneratePathProperty="true" IncludeAssets="none" NoWarn="NU1701" />
  </ItemGroup>
  <Import Project="../../build/WinGet.Native.targets" />
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.15" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App" RuntimeFrameworkVersion="10.0.15" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.15" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/UpdateDeck.ico" />
    <Resource Include="Assets/UpdateDeck-logo.png" />
    <Resource Include="Assets/UpdateDeck-Mark.png" />
  </ItemGroup>
</Project>